# Mẫu biến môi trường cho các container Airflow. Sao chép thành .env rồi sửa nếu cần:
#   cp .env.example .env
# File .env thật KHÔNG commit (đã có trong .gitignore); Astro tự nạp nó khi astro dev start.
# Bên trong mạng Docker, warehouse có tên "dwh" và cổng 5432.
# Giá trị dưới đây là mật khẩu demo của warehouse local, đổi khi dùng thật.
DWH_HOST=dwh
DWH_PORT=5432
DWH_DB=dwh
DWH_USER=dbt_runner
DWH_PASSWORD=dbt_runner_pw
BANKGEN_DATA_DIR=/usr/local/airflow/include/data_generator/data
