# Biến môi trường cho các container Airflow (Astro tự nạp file này).
# Bên trong mạng Docker, warehouse có tên "dwh" và cổng 5432.
# Chạy trên máy host thì KHÔNG cần file này: mặc định là localhost:5433.
DWH_HOST=dwh
DWH_PORT=5432
DWH_DB=dwh
DWH_USER=dbt_runner
DWH_PASSWORD=dbt_runner_pw
BANKGEN_DATA_DIR=/usr/local/airflow/include/data_generator/data
