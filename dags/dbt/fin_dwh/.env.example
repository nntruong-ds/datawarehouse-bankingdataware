# Mẫu biến môi trường cho lúc chạy dbt TRÊN MÁY BẠN. Sao chép thành .env:
#   cp .env.example .env
# dbt (từ bản 1.12) tự đọc file .env gần nhất tính từ thư mục đang đứng.
# Nếu thiếu file này, dbt sẽ đọc nhầm file .env ở gốc dự án (DWH_HOST=dwh, chỉ dùng trong Docker).
# Trong container Airflow, biến môi trường có sẵn được ưu tiên hơn file này nên không bị ảnh hưởng.
DWH_HOST=localhost
DWH_PORT=5433
